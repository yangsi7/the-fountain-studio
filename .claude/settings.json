{
  "description": "Unified Claude Code configuration for v0-eligibility-pdf-test project",
  "version": "1.0",

  "permissions": {
    "allow": [
      "mcp__serena__find_file",
      "mcp__serena__search_for_pattern",
      "WebSearch",
      "WebFetch(domain:pdf-lib.js.org)",
      "Bash(curl:*)",
      "mcp__supabase__search_docs",
      "mcp__gemini-cli__ask-gemini",
      "mcp__stripe__search_stripe_documentation",
      "mcp__supabase__list_tables",
      "mcp__browsermcp__browser_navigate",
      "mcp__Ref__ref_search_documentation",
      "mcp__Ref__ref_read_url",
      "mcp__supabase__execute_sql",
      "mcp__stripe__get_stripe_account_info",
      "mcp__stripe__list_products",
      "mcp__stripe__list_prices",
      "mcp__serena__check_onboarding_performed",
      "Bash(~/.claude-code-docs/claude-docs-helper.sh:*)",
      "Bash(./scripts/query-index.sh:*)",
      "Bash(tree:*)",
      "Bash(grep:*)"
    ],
    "deny": [],
    "ask": []
  },

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/SessionStart.sh",
            "description": "Initialize session and create documentation folder"
          }
        ]
      }
    ],

    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/context-loader.sh",
            "description": "Detect task type and load appropriate context profile",
            "timeout": 3
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Task",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/simple-event-logger.sh",
            "description": "Log file modifications and subagent invocations with session tracking",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-tracker.sh",
            "description": "Track subagent parent-child relationships and outputs",
            "timeout": 2
          }
        ]
      }
    ],

    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/SessionEnd.sh",
            "description": "Save checksums and checkpoint state"
          }
        ]
      }
    ]
  },

  "memory_system": {
    "version": "1.1",
    "orchestrator": "context.md",
    "event_log": "event-stream.md",
    "profiles": ["research", "feature", "bugfix", "ui", "database", "default"],
    "token_budget_max": 1500
  }
}